// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id       String @id @default(cuid())
  name     String
  email    String @unique
  password String
}

model Service {
  id          String   @id @default(cuid())
  name        String
  description String
  price       String? // Can be string like "$50.000" or "Desde $30.000"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Appointment {
  id          String   @id @default(cuid())
  clientName  String
  clientEmail String
  clientPhone String?
  date        DateTime // The booked date and time
  status      String   @default("CONFIRMED") // PENDING, CONFIRMED, CANCELLED
  serviceId   String?
  createdAt   DateTime @default(now())
}

model Settings {
  id         String @id @default(cuid())
  dailyLimit Int    @default(4)
}
